---
// Plan de estudios (Fase C, sección 5): cifras del plan (cifras.json, sección "plan")
// y malla por semestre (malla.json), agrupada por año.
//
// ISLA INTERACTIVA (única del sitio): filtro de la malla por año.
// - Sin JavaScript, la malla completa se ve igual (mejora progresiva): los botones parten ocultos.
// - Con JavaScript, aparecen botones "Todos / 1.er año / ..." que muestran solo el año elegido.
// Justificación: son 44 asignaturas; en un celular de 360 px la lista completa es muy larga, y la
// encuesta mostró que el público quiere saber "qué asignaturas tiene" (Fase B).
import { getCollection, type CollectionEntry } from 'astro:content';
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import ListaCifras from './ListaCifras.astro';
import Fuentes from './Fuentes.astro';
import { obtenerSeccion } from '../lib/contenido';

const seccion = await obtenerSeccion('plan');
const semestres: CollectionEntry<'malla'>[] = (await getCollection('malla')).sort(
	(a, b) => a.data.semestre - b.data.semestre,
);

// Año al que pertenece cada semestre: 1-2 → año 1, 3-4 → año 2, etc.
const anioDe = (semestre: number): number => Math.ceil(semestre / 2);
const anios: number[] = [...new Set(semestres.map((s) => anioDe(s.data.semestre)))];
const ordinal: Record<number, string> = { 1: '1.er', 2: '2.°', 3: '3.er', 4: '4.°' };
const total: number = semestres.reduce((suma, s) => suma + s.data.asignaturas.length, 0);
// Fuentes únicas de toda la malla (normalmente solo el folleto F02).
const fuentesMalla: { id: string }[] = [
	...new Map(semestres.flatMap((s) => s.data.fuentes).map((f) => [f.id, f])).values(),
];
---

<section id="plan-estudios" aria-labelledby="titulo-plan">
	<div class="contenedor">
		<EncabezadoSeccion seccion={seccion} idTitulo="titulo-plan" />
		<ListaCifras seccion="plan" />

		<h3 id="titulo-malla">Malla por semestre ({total} asignaturas)</h3>
		<Fuentes fuentes={fuentesMalla} />

		<!-- Filtro: oculto hasta que el script confirma que JavaScript está disponible. -->
		<div class="filtro" role="group" aria-label="Filtrar la malla por año" hidden data-filtro>
			<button type="button" aria-pressed="true" data-anio="todos">Todos</button>
			{
				anios.map((a) => (
					<button type="button" aria-pressed="false" data-anio={String(a)}>
						{ordinal[a] ?? `${a}.°`} año
					</button>
				))
			}
		</div>
		<p class="solo-lector" aria-live="polite" data-estado></p>

		<div class="grid">
			{
				semestres.map(({ data }) => (
					<article data-anio={String(anioDe(data.semestre))} aria-labelledby={`sem-${data.semestre}`}>
						<h4 id={`sem-${data.semestre}`}>
							Semestre {data.semestre}
							<span class="anio"> · {ordinal[anioDe(data.semestre)]} año</span>
						</h4>
						<ul>
							{data.asignaturas.map((nombre) => (
								<li>{nombre}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	// Isla del filtro por año. Es el único JavaScript del sitio (menos de 1 KB).
	// Muestra solo los semestres del año elegido y anuncia el cambio a lectores de pantalla.
	const filtro = document.querySelector<HTMLDivElement>('[data-filtro]');
	const estado = document.querySelector<HTMLParagraphElement>('[data-estado]');
	const tarjetas = document.querySelectorAll<HTMLElement>('#plan-estudios article[data-anio]');

	if (filtro && estado) {
		// Solo si el script corre se muestran los botones (mejora progresiva).
		filtro.hidden = false;
		const botones = filtro.querySelectorAll<HTMLButtonElement>('button[data-anio]');

		botones.forEach((boton: HTMLButtonElement) => {
			boton.addEventListener('click', () => {
				const elegido: string = boton.dataset.anio ?? 'todos';
				// Marca el botón activo (aria-pressed lo comunica a tecnologías de asistencia).
				botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
				// Oculta las tarjetas que no corresponden al año elegido.
				let visibles = 0;
				tarjetas.forEach((t: HTMLElement) => {
					const mostrar: boolean = elegido === 'todos' || t.dataset.anio === elegido;
					t.hidden = !mostrar;
					if (mostrar) visibles += 1;
				});
				estado.textContent = `Mostrando ${visibles} semestres.`;
			});
		});
	}
</script>

<style>
	.filtro {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0;
	}

	.filtro button {
		font: inherit;
		min-height: 2.75rem; /* Área táctil cómoda (WCAG 2.5.8: mínimo 24 px). */
		padding: 0.4rem 1rem;
		border: 2px solid var(--azul);
		border-radius: 999px;
		background: var(--fondo);
		color: var(--azul);
		cursor: pointer;
	}

	.filtro button[aria-pressed='true'] {
		background: var(--azul);
		color: #fff;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	article {
		background: var(--fondo);
		border: 1px solid var(--borde);
		border-radius: var(--radio);
		padding: 1rem;
	}

	article[hidden] {
		display: none;
	}

	h4 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
	}

	.anio {
		font-weight: 400;
		color: var(--suave);
	}

	ul {
		margin: 0;
		padding-left: 1.1rem;
	}
</style>
