---
// Encabezado del sitio (inspirado en encabezados de landing pages educativas):
//   - logo institucional a la izquierda, sobre fondo blanco (regla 4.6 del manual F15);
//   - menú por anclas con una entrada por sección (orden de la Fase C) y botón "Postula 2027".
// "Referencias" se enlaza desde el pie de página.
// Sin JavaScript: en pantallas angostas el menú pasa a una segunda fila con desplazamiento horizontal.
import Logo from './Logo.astro';

// Un enlace del menú: el id de la sección y el texto visible.
interface Enlace {
	id: string;
	texto: string;
}

const enlaces: Enlace[] = [
	{ id: 'sobre-la-carrera', texto: 'La carrera' },
	{ id: 'perfil-egreso', texto: 'Perfil' },
	{ id: 'campo-laboral', texto: 'Campo laboral' },
	{ id: 'plan-estudios', texto: 'Plan de estudios' },
	{ id: 'admision', texto: 'Admisión' },
	{ id: 'faq', texto: 'Preguntas' },
	{ id: 'respaldo', texto: 'Respaldo' },
];

const base: string = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Chip activo del menú en celular, sin JavaScript: se destaca el enlace de la sección a la que se saltó
// (selector :target). Al cargar la página sin ancla, se destaca el primero.
const cssChipActivo: string = `@media (max-width: 47.99rem) {
	html:not(:has(:target)) .encabezado nav li:first-child a,
	${enlaces.map((e) => `html:has(#${e.id}:target) .encabezado nav a[href="#${e.id}"]`).join(',\n\t')} {
		background: var(--marino);
		border-color: var(--marino);
		color: #fff;
	}
}`;
---

<header class="encabezado">
	<div class="contenedor fila">
		<a class="marca" href="#contenido" aria-label="Ir al inicio: Ingeniería en Informática UTEM">
			<span class="marca-completa"><Logo /></span>
			{/* Versión de celular: escudo con sigla (mismo dibujo oficial) y nombre de la carrera. */}
			<span class="marca-compacta">
				<img src={`${base}logos/logo-utem-compacto.svg`} alt="" width="30" height="44" decoding="async" />
				<span>Ingeniería Informática</span>
			</span>
		</a>
		<nav aria-label="Secciones de la página">
			<ul>
				{
					enlaces.map((e) => (
						<li>
							<a href={`#${e.id}`}>{e.texto}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="boton postula" href="#admision">Postula 2027</a>
	</div>
</header>

<style is:inline set:html={cssChipActivo}></style>

<style>
	.encabezado {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--fondo);
		/* Línea celeste de la Facultad de Ingeniería (F15, sección 4.2). */
		border-bottom: 4px solid var(--celeste);
	}

	.fila {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 1rem;
	}

	.marca-compacta {
		display: none;
	}

	.marca {
		display: block;
		/* Área de resguardo horizontal del logo. */
		padding-right: 12px;
	}

	nav {
		flex: 1;
		overflow-x: auto; /* El menú se desplaza en vez de romper el diseño. */
		min-width: 0;
	}

	ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		white-space: nowrap;
	}

	nav a {
		display: inline-block;
		padding: 0.6rem 0.45rem;
		color: var(--marino);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		border-bottom: 3px solid transparent;
	}

	nav a:hover {
		color: var(--azul);
		border-bottom-color: var(--celeste);
	}

	.postula {
		padding: 0.55rem 1.1rem;
	}

	/* En pantallas medianas y celular: logo y botón arriba, menú en una segunda fila. */
	@media (max-width: 68rem) {
		.fila {
			justify-content: space-between;
		}

		nav {
			order: 3;
			flex-basis: 100%;
			border-top: 1px solid var(--borde);
		}
	}

	/* En celular el encabezado no queda fijo: con logo de 200 px ocuparía demasiada pantalla.
	   El botón "Postula 2027" se oculta porque la portada ya tiene el mismo llamado a la acción. */
	@media (max-width: 30rem) {
		.encabezado {
			position: static;
		}

		.postula {
			display: none;
		}
	}

	/* En celular y tablet vertical (menos de 768 px) el menú se muestra como "chips":
	   botones redondeados de 44 px de alto (área táctil recomendada), en una fila que se desplaza
	   hacia los lados. La fila llega hasta el borde derecho para que se note que continúa. */
	@media (max-width: 47.99rem) {
		.marca {
			padding-right: 0;
			text-decoration: none;
		}

		.marca-completa {
			display: none;
		}

		.marca-compacta {
			display: flex;
			align-items: center;
			gap: 0.625rem;
			min-height: 60px;
			color: var(--azul);
			font-weight: 700;
			font-size: 0.9375rem;
		}

		.marca-compacta img {
			display: block;
			width: auto;
			height: 44px;
		}

		nav {
			margin-right: -1rem;
			scrollbar-width: none;
		}

		nav::-webkit-scrollbar {
			display: none;
		}

		ul {
			gap: 0.5rem;
			/* Espacio alrededor para que el contorno de foco no se corte. */
			padding: 0.5rem 1rem 0.75rem 0.25rem;
		}

		nav a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
			padding: 0 1rem;
			border: 1px solid var(--borde);
			border-radius: 999px;
		}

		nav a:hover,
		nav a:focus-visible {
			background: var(--marino);
			border-color: var(--marino);
			color: #fff;
		}
	}
</style>
