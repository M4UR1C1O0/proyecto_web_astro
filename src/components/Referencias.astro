---
import { getCollection } from 'astro:content';

const referencias = await getCollection('referencias');
---

<section id="referencias">
	<h2>Referencias</h2>
	<ol>
		{
			referencias.map(({ data }) => (
				<li>
					{data.autor} ({data.anio}). {data.url ? <a href={data.url}>{data.titulo}</a> : data.titulo}.
				</li>
			))
		}
	</ol>
</section>
