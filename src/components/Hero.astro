---
// Portada (Fase C, sección 1): nombre oficial, título y grado, duración, jornada y llamado a la acción.
// Diseño (ideas de landing pages educativas, adaptadas a la identidad UTEM):
//   - dos columnas: texto a la izquierda; foto con insignia flotante a la derecha;
//   - debajo, una franja oscura con 4 cifras destacadas e íconos (lo que el público pidió primero).
// Textos: secciones.json ("portada"). Cifras: cifras.json ("portada", "insignia", "franja"). Foto: imagenes.json.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Fuentes from './Fuentes.astro';
import Cita from './Cita.astro';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { obtenerSeccion, porOrden } from '../lib/contenido';

const seccion = await obtenerSeccion('portada');
const todas: CollectionEntry<'cifras'>[] = await getCollection('cifras');
const deSeccion = (nombre: CollectionEntry<'cifras'>['data']['secciones'][number]): CollectionEntry<'cifras'>[] =>
	porOrden(todas.filter((c) => c.data.secciones.includes(nombre)));

// Ficha básica (título, grado, duración, jornada y lugar), la franja de cifras y la insignia de la foto.
const ficha: CollectionEntry<'cifras'>[] = deSeccion('portada');
const franja: CollectionEntry<'cifras'>[] = deSeccion('franja');
const insignia: CollectionEntry<'cifras'> | undefined = deSeccion('insignia')[0];

// Vista de celular (menos de 768 px): fondo blanco con trama decorativa, foto bajo el título y
// recuadro destacado en celeste. El texto del recuadro está en secciones.json ("portada" > "destacado").
const destacado = seccion.data.destacado;

// Foto opcional solo para celular: si existe la imagen "portada-movil" en imagenes.json, reemplaza
// a la foto de la Facultad en pantallas angostas. Si no existe, se usa la misma foto en todos los tamaños.
const fotoMovil: CollectionEntry<'imagenes'> | undefined = await getEntry('imagenes', 'portada-movil');

// El período "Consultado el …" se omite en la ficha: esa fecha ya aparece en Referencias.
const mostrarPeriodo = (periodo: string): boolean => !periodo.startsWith('Consultado');
---

<section class="hero" aria-labelledby="titulo-portada">
	<!-- Trama decorativa de la vista de celular: pistas de circuito y símbolos de código.
	     Son dibujos propios, no aportan información y quedan ocultos para lectores de pantalla. -->
	<svg class="circuito arriba" viewBox="0 0 96 130" width="96" height="130" aria-hidden="true" focusable="false">
		<g fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M96 28H60v16H40" /><circle cx="36" cy="44" r="4" />
			<path d="M96 78H80v26H66" /><circle cx="62" cy="104" r="4" />
		</g>
		<text x="46" y="128" font-size="15">&lt;/&gt;</text>
	</svg>
	<svg class="circuito abajo" viewBox="0 0 140 30" width="140" height="30" aria-hidden="true" focusable="false">
		<g fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M140 12H98v10H72" /><circle cx="68" cy="22" r="4" />
		</g>
		<text x="24" y="26" font-size="15">01</text>
	</svg>
	<div class="contenedor columnas">
		<div class="texto">
			<p class="etiqueta">{seccion.data.pregunta}</p>
			<h1 id="titulo-portada">{seccion.data.titulo}</h1>
			{seccion.data.intro && <p class="bajada">{seccion.data.intro}</p>}
			<Fuentes fuentes={seccion.data.fuentes} />

			{
				destacado && (
					<p class="destacado">
						<strong>{destacado.titulo}</strong>
						{destacado.texto}
					</p>
				)
			}

			<div class="acciones">
				<a class="boton" href="#admision">Cómo postular</a>
				<a class="boton secundario" href="#plan-estudios">Ver la malla</a>
				<svg class="circuito izquierda" viewBox="0 0 104 44" width="104" height="44" aria-hidden="true" focusable="false">
					<g fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M0 22h58v14h30" /><circle cx="92" cy="36" r="4" />
					</g>
					<text x="18" y="13" font-size="14">01</text>
				</svg>
				<svg class="circuito derecha" viewBox="0 0 104 44" width="104" height="44" aria-hidden="true" focusable="false">
					<g fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M104 14H50v18H18" /><circle cx="14" cy="32" r="4" />
					</g>
					<text x="68" y="42" font-size="14">//</text>
				</svg>
			</div>

			<dl class="ficha">
				{
					ficha.map(({ data }) => (
						<div>
							<dt>{data.etiqueta}</dt>
							<dd>
								<span class="valor">{data.valor}</span>
								<span class="meta">
									{mostrarPeriodo(data.periodo) && <>{data.periodo} </>}
									{data.fuentes.map((f, i) => (
									<>
										{i > 0 && ' '}
										<Cita id={f.id} />
									</>
								))}
								</span>
							</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="imagen">
			<div class:list={['marco', { 'foto-escritorio': fotoMovil }]}>
				<Foto id="facultad-ingenieria" sizes="(min-width: 960px) 520px, 100vw" loading="eager" />
			</div>
			{
				fotoMovil && (
					<div class="marco foto-movil">
						<Foto id="portada-movil" sizes="100vw" />
					</div>
				)
			}
			{
				insignia && (
					<div class="insignia">
						{insignia.data.icono && <Icono nombre={insignia.data.icono} class="insignia-icono" />}
						<p>
							<strong>{insignia.data.valor}</strong>
							<span>{insignia.data.etiquetaCorta ?? insignia.data.etiqueta}</span>
							<small>
								{insignia.data.periodo}.{' '}
								{insignia.data.fuentes.map((f, i) => (
									<>
										{i > 0 && ' '}
										<Cita id={f.id} />
									</>
								))}
							</small>
						</p>
					</div>
				)
			}
		</div>
	</div>
</section>

<!-- Franja de cifras destacadas, en azul complementario (F15, 4.4) con números en celeste (6,7:1). -->
<section class="franja" aria-labelledby="titulo-franja">
	<div class="contenedor">
		<h2 id="titulo-franja" class="solo-lector">Cifras destacadas</h2>
		<ul class="cifras-franja">
			{
				franja.map(({ data }) => (
					<li class="item">
						{data.icono && <Icono nombre={data.icono} class="franja-icono" />}
						<div>
							<p class="numero">{data.valorCorto ?? data.valor}</p>
							<p class="etiqueta-cifra">{data.etiquetaCorta ?? data.etiqueta}</p>
							<p class="periodo">
								{data.periodo}.{' '}
								{data.fuentes.map((f, i) => (
									<>
										{i > 0 && ' '}
										<Cita id={f.id} />
									</>
								))}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		/* Color predominante: celeste de la Facultad de Ingeniería (F15, sección 4.2).
		   El texto va en azul complementario (#0B2341), que sobre celeste da 6,7:1 de contraste. */
		background: var(--celeste);
		color: var(--marino);
		padding: 3rem 0 3.5rem;
	}

	.columnas {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 60rem) {
		.columnas {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 3rem;
		}
	}

	.etiqueta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		color: var(--marino);
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* Guion decorativo antes de la etiqueta. */
	.etiqueta::before {
		content: '';
		width: 2rem;
		height: 3px;
		background: var(--marino);
	}

	h1 {
		color: var(--marino);
		font-size: clamp(2.4rem, 7.5vw, 4.2rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		margin: 0.75rem 0 0;
	}

	.bajada {
		font-size: 1.2rem;
		max-width: 38rem;
		margin: 1rem 0 0;
	}

	/* Citas y enlaces sobre celeste: azul complementario (contraste 6,7:1, AA).
	   El azul institucional #004EAA no se usa aquí porque sobre celeste solo da 3,3:1. */
	.texto :global(.fuente),
	.meta,
	.texto :global(a.cita),
	.imagen :global(figcaption),
	.imagen :global(figcaption a) {
		color: var(--marino);
	}

	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0;
	}

	/* Ficha: filas "etiqueta | valor" separadas por líneas finas. */
	.ficha {
		margin: 0;
		border-top: 1px solid rgba(11, 35, 65, 0.3);
	}

	.ficha div {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0.75rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid rgba(11, 35, 65, 0.3);
	}

	.ficha dt {
		font-size: 0.95rem;
	}

	.ficha dd {
		margin: 0;
	}

	.ficha .valor {
		font-weight: 700;
		margin-right: 0.4rem;
	}

	.meta {
		font-size: 0.8rem;
	}

	@media (max-width: 30rem) {
		.ficha div {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}

	/* Foto con esquinas redondeadas y la insignia flotante. */
	.imagen {
		position: relative;
	}

	.imagen :global(img) {
		border: 6px solid #fff;
		box-shadow: 0 18px 40px rgba(11, 35, 65, 0.25);
	}

	.insignia {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		background: #fff;
		color: var(--marino);
		border-radius: 14px;
		padding: 0.8rem 1rem;
		box-shadow: 0 10px 25px rgba(11, 35, 65, 0.25);
		max-width: 17rem;
		/* En celular la insignia va debajo del crédito de la foto, sin taparlo. */
		margin-top: 1rem;
	}

	@media (min-width: 60rem) {
		.insignia {
			position: absolute;
			right: -1.25rem;
			top: 1.5rem;
			margin: 0;
		}
	}

	.insignia :global(.insignia-icono) {
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		padding: 0.45rem;
		border-radius: 50%;
		background: var(--celeste);
		color: var(--marino);
	}

	.insignia p {
		margin: 0;
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.insignia strong {
		font-size: 1.6rem;
	}

	.insignia small {
		color: var(--suave);
		font-size: 0.75rem;
		margin-top: 0.2rem;
	}

	/* ----- Vista de celular (menos de 768 px) -----
	   Rediseño del 13-11-2026: fondo blanco con trama de puntos y circuitos, foto bajo el título,
	   recuadro destacado en un tinte claro del celeste de la Facultad (F15 4.2), botones a todo el ancho y ficha en tarjetas.
	   Desde 768 px la portada se ve igual que antes. */
	.destacado,
	.circuito,
	.foto-movil {
		display: none;
	}

	@media (max-width: 47.99rem) {
		.hero {
			position: relative;
			overflow: hidden;
			padding: 1.25rem 0 2.25rem;
			background-color: var(--fondo);
			/* Trama de puntos en azul institucional muy tenue (decorativa). */
			background-image: radial-gradient(circle, rgba(0, 78, 170, 0.16) 1.1px, transparent 1.7px);
			background-size: 20px 20px;
		}

		.circuito {
			display: block;
			position: absolute;
			right: 0;
			color: var(--azul);
			fill: var(--azul);
			opacity: 0.2;
			font-family: ui-monospace, Consolas, 'Courier New', monospace;
			font-weight: 700;
			pointer-events: none;
		}

		.circuito.arriba {
			top: 0;
		}

		.circuito.abajo {
			bottom: 0;
		}

		/* Pistas a los lados del enlace "Ver la malla": llegan hasta el borde de la pantalla. */
		.circuito.izquierda,
		.circuito.derecha {
			bottom: 0;
		}

		.circuito.izquierda {
			left: -1rem;
			right: auto;
		}

		.circuito.derecha {
			right: -1rem;
		}

		/* Los hijos de .texto pasan a ser elementos de la grilla para poder intercalar la foto:
		   etiqueta, título, foto, recuadro, botones, ficha y, al final, la bajada con su cita. */
		.columnas {
			position: relative;
			gap: 1.125rem;
			align-items: stretch;
		}

		.texto {
			display: contents;
		}

		/* En celular el chip "La carrera" ya cumple el papel de la etiqueta, así que se oculta. */
		.etiqueta {
			display: none;
		}

		h1 {
			order: 2;
			margin: 0;
			font-size: 2.5rem;
			line-height: 1.08;
		}

		/* La foto va bajo el título; la insignia de certificación baja después de la ficha. */
		.imagen {
			display: contents;
		}

		.marco {
			order: 3;
		}

		.destacado {
			display: block;
			order: 4;
			margin: 0;
			padding: 1.125rem;
			border-radius: 16px;
			background: var(--celeste-claro);
			color: var(--texto);
			line-height: 1.5;
		}

		.destacado strong {
			display: block;
		}

		.acciones {
			position: relative;
			order: 5;
			flex-direction: column;
			gap: 0.25rem;
			margin: 0;
		}

		.acciones .boton {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 52px;
			text-align: center;
		}

		/* En celular el botón secundario se muestra como enlace, para dar más peso a "Cómo postular". */
		.acciones .boton.secundario {
			min-height: 44px;
			border-color: transparent;
			color: var(--azul);
			text-decoration: underline;
		}

		.ficha {
			order: 6;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.625rem;
			border-top: 0;
		}

		.ficha div {
			display: block;
			padding: 0.75rem 0.875rem;
			background: var(--fondo);
			border: 1px solid var(--borde);
			border-radius: 12px;
		}

		/* El título profesional ocupa todo el ancho; el resto va de a dos tarjetas por fila. */
		.ficha div:first-child {
			grid-column: 1 / -1;
		}

		.ficha dt {
			font-size: 0.8rem;
			color: var(--suave);
		}

		.ficha .valor {
			display: block;
			margin-right: 0;
		}

		.bajada {
			order: 8;
			margin: 0;
			font-size: 1rem;
		}

		.texto :global(.fuente) {
			order: 9;
			margin-top: -0.75rem;
		}

		.imagen :global(img) {
			aspect-ratio: 2 / 1;
			border: 0;
			border-radius: 16px;
			box-shadow: none;
		}

		.foto-escritorio {
			display: none;
		}

		.foto-movil {
			display: block;
		}

		.insignia {
			order: 7;
			margin-top: 0;
			max-width: none;
			border: 1px solid var(--borde);
			box-shadow: none;
		}
	}

	/* ----- Franja de cifras ----- */
	.franja {
		background: var(--marino);
		color: #fff;
		padding: 1.75rem 0;
		border-bottom: 6px solid var(--celeste);
	}

	.cifras-franja {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		gap: 1.25rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
	}

	/* Separadores verticales entre cifras en escritorio. */
	@media (min-width: 60rem) {
		.item + .item {
			border-left: 1px solid rgba(255, 255, 255, 0.2);
			padding-left: 2rem;
		}
	}

	.franja :global(.franja-icono) {
		flex: none;
		width: 2.6rem;
		height: 2.6rem;
		color: var(--celeste);
	}

	.item p {
		margin: 0;
	}

	.etiqueta-cifra {
		font-weight: 600;
	}

	.numero {
		font-size: 1.55rem;
		font-weight: 800;
		color: var(--celeste);
		line-height: 1.15;
	}

	.periodo {
		font-size: 0.78rem;
		color: #dbe6f3;
		margin-top: 0.2rem;
	}

	/* Las citas heredan el gris claro del período: discretas, con contraste 13:1 sobre el fondo. */
	.franja :global(a.cita) {
		color: inherit;
	}
</style>
