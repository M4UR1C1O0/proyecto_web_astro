---
// Íconos propios en SVG (trazos simples, 24×24). Son decorativos: se ocultan a lectores de pantalla,
// porque el texto que los acompaña ya comunica el dato.
import type { CollectionEntry } from 'astro:content';

type NombreIcono = NonNullable<CollectionEntry<'cifras'>['data']['icono']>;

interface Props {
	nombre: NombreIcono;
	/** Clase CSS opcional para dar tamaño y color desde el componente que lo usa. */
	class?: string;
}

const { nombre, class: clase } = Astro.props;

// Trazos de cada ícono.
const trazos: Record<NombreIcono, string> = {
	// Maletín: trabajo.
	empleo: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
	// Billete: ingresos.
	dinero: 'M3 7h18v10H3zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM6 10v4M18 10v4',
	// Escudo con visto bueno: acreditación.
	escudo: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6zM9 12l2 2 4-4',
	// Personas: vacantes.
	personas: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5a3 3 0 0 1 0 6M18 14c2 .6 3 2.7 3 6',
	// Medalla: certificación.
	certificado: 'M12 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM8.5 13 7 21l5-3 5 3-1.5-8',
	// Sobre: correo.
	correo: 'M3 6h18v12H3zM3 7l9 6 9-6',
	// Pin: ubicación.
	ubicacion: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z',
};
---

<svg
	class={clase}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"><path d={trazos[nombre]}></path></svg
>
