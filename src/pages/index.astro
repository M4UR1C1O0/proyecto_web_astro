---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PerfilEgreso from '../components/PerfilEgreso.astro';
import Malla from '../components/Malla.astro';
import CampoLaboral from '../components/CampoLaboral.astro';
import Faq from '../components/Faq.astro';
import Referencias from '../components/Referencias.astro';
---

<BaseLayout
	title="Nombre de la carrera"
	description="Conoce la carrera: perfil de egreso, malla curricular, campo laboral y preguntas frecuentes."
>
	<Hero titulo="Nombre de la carrera" subtitulo="Descripción breve de la carrera" />
	<PerfilEgreso />
	<Malla />
	<CampoLaboral />
	<Faq />
	<Referencias />
</BaseLayout>
