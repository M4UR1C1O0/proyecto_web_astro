---
// Página única del sitio. El orden de las secciones sigue la Fase C del informe,
// basada en lo que el público pidió saber primero en la encuesta de la Fase B.
//
// Las nueve secciones de la propuesta (Fase C) se muestran con su contenido.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SobreCarrera from '../components/SobreCarrera.astro';
import PerfilEgreso from '../components/PerfilEgreso.astro';
import Respaldo from '../components/Respaldo.astro';
import Referencias from '../components/Referencias.astro';
import LlamadoPostular from '../components/LlamadoPostular.astro';
import CampoLaboral from '../components/CampoLaboral.astro';
import Malla from '../components/Malla.astro';
import Admision from '../components/Admision.astro';
import Faq from '../components/Faq.astro';
---

<BaseLayout
	title="Ingeniería en Informática UTEM: plan, campo laboral y admisión 2027"
	description="Ingeniería en Informática en la UTEM: 8 semestres, perfil de egreso, malla, empleabilidad, ponderaciones y fechas de Admisión 2027, con fuentes oficiales."
	image="og.png"
	imageAlt="Ingeniería en Informática UTEM: información para postulantes con fuentes oficiales"
>
	<Hero />
	<SobreCarrera />
	<PerfilEgreso />
	<CampoLaboral />
	<Malla />
	<Admision />
	<Faq />
	<Respaldo />
	<!-- Banda de llamado a postular, antes de las referencias y el pie. -->
	<LlamadoPostular />
	<Referencias />
</BaseLayout>
