---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Información de la carrera' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		font-family: system-ui, sans-serif;
		line-height: 1.6;
		color: #1f2328;
		background: #ffffff;
	}

	body {
		margin: 0;
	}

	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	section {
		padding: 2rem 0;
	}
</style>
